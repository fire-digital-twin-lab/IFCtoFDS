{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fire-digital-twin-lab/IFCtoFDS/docs/science/evidence-manifest.schema.json",
  "title": "IFCtoFDS Scientific Evidence Manifest",
  "description": "Machine-readable manifest for a scientific evidence run. This complements, but does not replace, runtime result_evidence.json integrity indexes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "timestamp_utc",
    "git",
    "environment",
    "inputs",
    "configuration",
    "commands",
    "claims",
    "artifacts",
    "overall_verdict",
    "known_limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "branch",
        "dirty"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "node_version",
        "ifcopenshell_version",
        "fds_version",
        "os",
        "cpu"
      ],
      "properties": {
        "python_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "ifcopenshell_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "fds_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hashedInput"
      }
    },
    "configuration": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hashedInput"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "evidence_level",
          "verdict",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "evidence_level": {
            "$ref": "#/$defs/evidenceLevel"
          },
          "verdict": {
            "$ref": "#/$defs/verdict"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "overall_verdict": {
      "$ref": "#/$defs/verdict"
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "NOT_APPLICABLE"
      ]
    },
    "evidenceLevel": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
